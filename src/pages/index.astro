---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import Hud from "../components/Hud.astro";
import Booking from "../components/chapters/Booking.astro";
import Breakdown from "../components/chapters/Breakdown.astro";
import Dates from "../components/chapters/Dates.astro";
import Drop from "../components/chapters/Drop.astro";
import Intro from "../components/chapters/Intro.astro";
import Montee from "../components/chapters/Montee.astro";
import { copy } from "../lib/content";
import { structuredData } from "../lib/seo";
---

<Base story jsonLd={structuredData()}>
  <main id="contenu">
    <Intro />
    <Montee />
    <Drop />
    <Breakdown />
    <Dates />
    <Booking />
  </main>
  <div class="has-hud">
    <Footer />
  </div>
  <Hud live chapters={copy.chapters} cta={{ href: "#booking", label: "Booking" }} />
</Base>
