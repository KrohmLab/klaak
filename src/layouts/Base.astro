---
import "@fontsource-variable/unbounded";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { site } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
}
const { title = `${site.name} — ${site.tagline}`, description = `${site.name}, ${site.tagline}. Co-fondateur du collectif ${site.collective}, ${site.city}.` } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07060d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Site en construction : à retirer à la mise en production (étape 5). -->
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
    <script>
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
