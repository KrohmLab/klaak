---
import "@fontsource-variable/unbounded";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { bio, site } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  /** La page gère elle-même son animation (v2 Hyperespace) : ni GSAP ni patterns v1. */
  bare?: boolean;
  jsonLd?: object;
  /** Pages internes (styleguide, 404) : jamais indexées. */
  noindex?: boolean;
}
const sentence = bio.fr.split(". ").slice(0, 1).join("") + ".";
const { title = `${site.name} — ${site.tagline} · ${site.collective}, ${site.city}`, description = sentence, bare = false, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = new URL("/og.png", site.url).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07060d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !site.indexable) && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo Klaak en glitch chromatique" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Mode calme, posé avant le premier rendu : réglage système ou choix du visiteur (pied de page). -->
    <script is:inline>
      try {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches || localStorage.getItem("calme") === "1") document.documentElement.dataset.calm = "";
      } catch (e) {}
    </script>
  </head>
  <body data-motion={bare ? "none" : "basic"}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
    <script>
      // Chargé à la demande : une page « bare » (v2) ne télécharge jamais GSAP.
      const motion = document.body.dataset.motion;
      if (motion === "basic") import("../scripts/motion").then((m) => m.initMotion());
    </script>
  </body>
</html>
