---
import "@fontsource/unbounded/900.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
}
const { title = `${site.name} — ${site.tagline}`, description = `${site.name}, ${site.tagline}. Co-fondateur du collectif ${site.collective}, ${site.city}.` } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Site en construction : à retirer à la mise en production (étape 5). -->
    <meta name="robots" content="noindex" />
  </head>
  <body class="min-h-dvh font-mono antialiased">
    <slot />
  </body>
</html>
