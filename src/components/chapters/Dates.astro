---
// Chapitre 4 — Montée finale : l'historique des dates, en frise horizontale.
// Par défaut : carrousel natif à cran (pouce, clavier). Sur grand écran avec animations : frise épinglée
// qui défile avec le scroll (src/scripts/scenes/dates.ts).
import DateCard from "../DateCard.astro";
import { copy, dates } from "../../lib/content";
const d = copy.dates;
const years = [...new Set(dates.map((date) => date.start.slice(0, 4)))];
---

<section id="dates" class="dates" data-chapter>
  <div class="wrap dates__head">
    <p class="t-label text-acid">{copy.chapters[4]?.label}</p>
    <h2 class="t-h1 mt-3"><span class="glitch" data-text={d.title} data-motion="klaak">{d.title}</span></h2>
    <p class="t-label mt-4 text-mute">{String(dates.length).padStart(2, "0")} dates · {years.join(" → ")}</p>
  </div>

  <div class="dates__viewport" tabindex="0" role="region" aria-label="Historique des dates, défilement horizontal">
    <ol class="dates__track">
      {
        dates.map((date) => (
          <li>
            <DateCard date={date} />
          </li>
        ))
      }
      <li>
        <a class="dates__next" href="#booking">
          <span class="t-label">{d.nextLabel}</span>
          <span class="t-h1">{d.nextTitle}</span>
          <span class="btn">{d.nextCta}</span>
        </a>
      </li>
    </ol>
  </div>
</section>

<style>
  .dates {
    padding-block: var(--section);
    overflow: hidden;
  }
  .dates__viewport {
    margin-top: clamp(2rem, 5vw, 4rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--color-acid) var(--color-void-2);
    -webkit-overflow-scrolling: touch;
  }
  .dates__track {
    display: flex;
    gap: 1rem;
    width: max-content;
    padding: 0.5rem var(--gutter) 1.5rem;
  }
  .dates__track > li {
    flex: none;
    display: flex;
    width: clamp(17rem, 80vw, 27rem);
    scroll-snap-align: start;
  }
  .dates__track :global(.date-card) {
    width: 100%;
  }
  .dates__next {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.25rem;
    width: 100%;
    min-height: 22rem;
    padding: 2rem;
    color: var(--color-void);
    background: var(--color-acid);
    text-decoration: none;
  }
  .dates__next .btn {
    color: var(--color-acid);
    background: var(--color-void);
    border-color: var(--color-void);
  }

  /* Frise épinglée (grand écran, animations actives) */
  :global(.is-pinned-dates) .dates {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-block: 2rem 5rem;
  }
  :global(.is-pinned-dates) .dates__viewport {
    overflow: visible;
    scroll-snap-type: none;
  }
  :global(.is-pinned-dates) .dates__track {
    will-change: transform;
  }
</style>
