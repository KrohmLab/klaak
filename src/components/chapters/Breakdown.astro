---
// Chapitre 3 — Breakdown : on respire. Portrait, bio complète en français et en anglais.
import { Picture } from "astro:assets";
import { bio, copy, photo } from "../../lib/content";
const b = copy.breakdown;
---

<section id="breakdown" class="breakdown" data-chapter>
  <div class="wrap breakdown__grid">
    <figure class="breakdown__portrait duo duo--magenta grain">
      <Picture src={photo("breakdown-portrait")} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(min-width: 64rem) 42vw, 92vw" alt={b.portraitAlt} loading="lazy" />
    </figure>

    <div class="breakdown__text">
      <p class="t-label text-magenta">{copy.chapters[3]?.label}</p>
      <h2 class="t-h1 mt-3" data-motion="split">{b.title}</h2>

      <div class="bio-switch mt-10" role="group" aria-label="Langue de la bio">
        <button type="button" class="tag" data-bio-lang="fr" aria-pressed="true">Français</button>
        <button type="button" class="tag" data-bio-lang="en" aria-pressed="false" lang="en">English</button>
      </div>
      <p class="bio mt-6" data-bio="fr">{bio.fr}</p>
      <p class="bio mt-6" data-bio="en" lang="en" hidden>{bio.en}</p>

      <dl class="breakdown__facts mt-10">
        {
          b.facts.map((fact) => (
            <div>
              <dt class="t-label text-mute">{fact.label}</dt>
              <dd class="mt-1">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-bio-lang]");
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const lang = button.dataset.bioLang;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      document.querySelectorAll<HTMLElement>("[data-bio]").forEach((text) => (text.hidden = text.dataset.bio !== lang));
    }),
  );
</script>

<style>
  .breakdown {
    padding-block: var(--section);
    background: linear-gradient(var(--color-void), #0d0718 30%, #0d0718 70%, var(--color-void));
  }
  .breakdown__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .breakdown__portrait {
    aspect-ratio: 4 / 5;
    max-height: 80svh;
    width: 100%;
  }
  .breakdown__portrait :global(picture) {
    display: contents;
  }
  .breakdown__portrait :global(img) {
    object-position: 78% 30%;
  }
  .bio {
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.75;
    max-width: 58ch;
  }
  .bio-switch {
    display: flex;
    gap: 0.5rem;
  }
  .bio-switch button {
    min-height: 2.75rem;
    padding-inline: 1rem;
    cursor: pointer;
    color: var(--color-mute);
  }
  .bio-switch button[aria-pressed="true"] {
    color: var(--color-void);
    background: var(--color-magenta);
    border-color: var(--color-magenta);
  }
  .breakdown__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-void-3);
  }
  @media (min-width: 64rem) {
    .breakdown__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }
</style>
