---
// Chapitre 0 — Intro : écran noir, le logo claque, puis le scroll nous fait traverser le logo.
import Logo from "../Logo.astro";
import { copy, site } from "../../lib/content";
---

<section id="intro" class="intro scanlines" data-chapter>
  <div class="intro__inner">
    <h1 class="intro__logo"><span class="intro__kick"><Logo /></span></h1>
    <p class="intro__meta t-label">{site.tagline} · {site.collective} · {site.city}</p>
  </div>
  <p class="intro__cue t-label" aria-hidden="true"><span>{copy.intro.cue}</span><i></i></p>
</section>

<style>
  .intro {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(60% 45% at 30% 40%, rgb(25 227 255 / 0.1), transparent 70%),
      radial-gradient(55% 45% at 72% 62%, rgb(255 43 214 / 0.12), transparent 70%), var(--color-void);
  }
  .intro__inner {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    width: 100%;
    padding: var(--gutter);
    padding-bottom: 6rem;
  }
  .intro__logo {
    width: min(88vw, 60rem);
    will-change: transform;
  }
  .intro__kick {
    display: block;
  }
  .intro__meta {
    color: var(--color-bone);
    text-align: center;
  }
  .intro__cue {
    position: absolute;
    inset-inline: 0;
    bottom: 5.5rem;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    color: var(--color-acid);
  }
  .intro__cue i {
    width: 2px;
    height: 2.5rem;
    background: linear-gradient(var(--color-acid), transparent);
    animation: cue 1.4s var(--ease-rise) infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
    }
    60% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }
</style>
