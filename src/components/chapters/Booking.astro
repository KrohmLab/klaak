---
// Chapitre 5 — Dernier drop : le formulaire de booking. Envoi vers /api/booking (worker/index.ts).
import Todo from "../Todo.astro";
import { copy, site } from "../../lib/content";
const b = copy.booking;
const f = b.fields;
const ready = site.turnstileSiteKey.trim() !== "";
const title = b.title.join(" ");
---

<section id="booking" class="booking" data-chapter>
  <div class="wrap">
    <p class="t-label text-acid">{copy.chapters[5]?.label}</p>
    <h2 class="t-mega booking__title mt-4" aria-label={title}>
      <span class="glitch" data-text={title} data-motion="rise" aria-hidden="true">{b.title.map((line) => <span class="block">{line}</span>)}</span>
    </h2>
    <p class="t-lead mt-8">{b.lead}</p>

    <div class="booking__grid">
      <form class="booking__form" novalidate data-booking data-sitekey={site.turnstileSiteKey} data-msg-required={b.required} data-msg-email={b.emailInvalid} data-msg-captcha={b.captcha} data-msg-error={b.error} data-msg-success={b.success} data-msg-sending={b.sending}>
        <div class="field">
          <label class="t-label" for="bk-name">{f.name} *</label>
          <input id="bk-name" name="name" type="text" autocomplete="name" required maxlength="120" />
        </div>
        <div class="field">
          <label class="t-label" for="bk-email">{f.email} *</label>
          <input id="bk-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" />
        </div>
        <div class="field booking__wide">
          <label class="t-label" for="bk-structure">{f.structure} *</label>
          <input id="bk-structure" name="structure" type="text" autocomplete="organization" required maxlength="200" />
        </div>
        <div class="field">
          <label class="t-label" for="bk-date">{f.date} *</label>
          <input id="bk-date" name="date" type="text" required maxlength="80" />
        </div>
        <div class="field">
          <label class="t-label" for="bk-place">{f.place} *</label>
          <input id="bk-place" name="place" type="text" required maxlength="200" />
        </div>
        <div class="field booking__wide">
          <label class="t-label" for="bk-duration">{f.duration}</label>
          <input id="bk-duration" name="duration" type="text" maxlength="80" />
        </div>
        <div class="field booking__wide">
          <label class="t-label" for="bk-message">{f.message}</label>
          <textarea id="bk-message" name="message" maxlength="4000"></textarea>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="bk-website">Ne pas remplir</label>
          <input id="bk-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="booking__wide booking__send">
          <div data-turnstile></div>
          {
            !ready && (
              <p class="text-sm">
                Formulaire inactif : <Todo what="clé de site Turnstile" />
              </p>
            )
          }
          <button class="btn btn--big" type="submit" disabled={!ready}>{b.submit}</button>
          <p class="booking__status" role="status" aria-live="polite" data-status></p>
        </div>
      </form>

      <aside class="booking__aside">
        <p class="t-label text-mute">{b.mailto}</p>
        <a class="link booking__mail" href={`mailto:${site.bookingEmail}`}>{site.bookingEmail}</a>
      </aside>
    </div>
  </div>
</section>

<script>
  import { initBooking } from "../../scripts/booking";
  initBooking();
</script>

<style>
  .booking {
    padding-block: var(--section);
    background:
      radial-gradient(70% 40% at 80% 0%, rgb(198 255 26 / 0.1), transparent 70%),
      radial-gradient(60% 40% at 0% 100%, rgb(255 43 214 / 0.1), transparent 70%);
    overflow: hidden;
  }
  .booking__title {
    font-size: clamp(3rem, 15.5vw, 15rem); /* « Bookez » doit tenir sur une ligne à toutes les largeurs */
    color: var(--color-acid);
  }
  .booking__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .booking__form {
    display: grid;
    gap: 2rem 1.5rem;
  }
  .booking__send {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }
  .booking__send .btn {
    width: 100%;
  }
  .booking__status:empty {
    display: none;
  }
  .booking__status[data-kind="error"] {
    color: var(--color-magenta);
  }
  .booking__status[data-kind="success"] {
    color: var(--color-acid);
  }
  .booking__mail {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: clamp(1.1rem, 2.4vw, 1.75rem);
    overflow-wrap: anywhere;
  }
  @media (min-width: 40rem) {
    .booking__form {
      grid-template-columns: 1fr 1fr;
    }
    .booking__wide {
      grid-column: 1 / -1;
    }
    .booking__send .btn {
      width: auto;
    }
  }
  @media (min-width: 64rem) {
    .booking__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    }
  }
</style>
