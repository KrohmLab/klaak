---
// Chapitre 1 — Montée : la typographie grossit phrase après phrase jusqu'à « La Hitech ».
// Sans JS ou en mode calme : les phrases sont simplement empilées, lisibles d'un seul regard.
import { Picture } from "astro:assets";
import { copy, photo } from "../../lib/content";
const m = copy.montee;
---

<section id="montee" class="montee" data-chapter>
  <div class="montee__bg duo duo--cyan grain" aria-hidden="true">
    <Picture src={photo("montee-casque")} formats={["avif", "webp"]} widths={[480, 800, 1280, 1920]} sizes="100vw" alt="" loading="lazy" />
  </div>
  <div class="montee__stage wrap">
    <h2 class="montee__step t-h1">{m.years.map((line) => <span class="block">{line}</span>)}</h2>
    <p class="montee__step t-h1 text-acid">{m.reveal}</p>
    <p class="montee__step t-mega"><span class="glitch" data-text={m.hitech}>{m.hitech}</span></p>
    <ul class="montee__step montee__words t-h1">
      {m.words.map((word) => <li>{word}</li>)}
    </ul>
  </div>
</section>

<style>
  .montee {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .montee__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.38;
  }
  .montee__bg :global(picture) {
    display: contents;
  }
  .montee__stage {
    display: grid;
    gap: clamp(2.5rem, 8vw, 5rem);
    padding-block: var(--section);
    text-align: center;
    justify-items: center;
  }
  .montee__words {
    display: grid;
    gap: 0.35em;
  }
  .montee__words li:nth-child(1) {
    color: var(--color-cyan);
  }
  .montee__words li:nth-child(2) {
    color: var(--color-magenta);
  }
  .montee__words li:nth-child(3) {
    color: var(--color-acid);
  }

  /* Mode « scène » (posé par le JS) : un seul écran, les phrases se succèdent au centre */
  :global(.is-story) .montee {
    height: 100svh;
  }
  :global(.is-story) .montee__stage {
    position: relative;
    height: 100%;
    padding-block: 0;
  }
  :global(.is-story) .montee__step {
    position: absolute;
    inset: 0 var(--gutter) 3rem;
    display: grid;
    place-content: center;
    will-change: transform, opacity;
  }
</style>
