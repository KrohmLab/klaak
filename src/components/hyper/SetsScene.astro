---
// Scène 05 — Les sets : tracklist à gauche, pochette du set dans la lentille avec un gros bouton lecture,
// panneau « en lecture » à droite. La lecture (SoundCloud), la waveform cliquable et le kick arrivent à l'étape 4 ;
// ici : choix du set (recolore tout le site) et navigation.
// Le gros bouton est aussi visible depuis la scène 04, à travers le portail : il y fait voyager jusqu'ici.
import { Picture } from "astro:assets";
import hyper from "../../data/hyper.json";
import { photo, poster, sets } from "../../lib/content";
import { wave } from "../../lib/wave";

const t = hyper.sets;
// Cadrage d'une photo dans la lentille, visage au centre (zoom 2, sans bord visible) : port de `fit()` du prototype.
const fit = (ar: number, fx: number, fy: number) => {
  const z = 2;
  const w = 100 * ar * z;
  const h = 100 * z;
  return `width:${w}%;height:${h}%;left:${Math.max(100 - w, Math.min(0, 50 - fx * w)).toFixed(1)}%;top:${Math.max(100 - h, Math.min(0, 50 - fy * h)).toFixed(1)}%`;
};
const arts = sets.map((s) => {
  if ("poster" in s.art && s.art.poster) return { img: poster(s.art.poster), style: "" };
  const a = s.art as { photo: string; fx: number; fy: number };
  const img = photo(a.photo);
  return { img, style: fit(img.width / img.height / 1, a.fx, a.fy) };
});
---

<section id="sets" class="hx-scene hx-sets" data-hx-scene data-hx-preview data-hx-s0="1" data-hx-len="1.5" data-hx-stops="0.5" aria-labelledby="sets-title" data-sets={JSON.stringify(sets.map(({ title, sub, url, color }) => ({ title, sub, url, color })))}>
  <div class="hx-lens" aria-hidden="true">
    <div class="hx-lens__in">
      {
        arts.map((a, i) =>
          a.img ? (
            <div class:list={["hx-art", a.style && "hx-art--fit"]} data-set-art={i} style={i === 0 ? undefined : "opacity:0"}>
              <Picture src={a.img} formats={["avif", "webp"]} widths={[400, 720, 1080]} sizes="40vh" alt="" loading="lazy" style={a.style || undefined} />
            </div>
          ) : null,
        )
      }
    </div>
  </div>
  <div class="hx-portal" aria-hidden="true"></div>
  <div class="hx-portal2" aria-hidden="true"></div>
  <button class="hx-pbig" type="button" data-hx-playbig aria-label={`${t.listen} : ${sets[0]?.title}`}>
    <svg width="34" height="34" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z" fill="currentColor"></path></svg>
  </button>

  <div class="hx-tl" data-hx-text>
    <p class="hx-mono" style="color:var(--wc)">{t.kicker}</p>
    <h2 id="sets-title" class="hx-mega hx-tl__title">{t.title}</h2>
    {
      sets.map((s, i) => (
        <button class:list={["hx-trk", i === 0 && "is-on"]} type="button" data-set-pick={i} aria-pressed={i === 0 ? "true" : "false"}>
          <span class="hx-trk__n">{String(i + 1).padStart(2, "0")}</span>
          <span class="hx-trk__txt">
            <span class="hx-trk__title">{s.title}</span>
            <span class="hx-trk__sub">{s.sub}</span>
          </span>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 4l13 8-13 8z" fill="currentColor" />
          </svg>
        </button>
      ))
    }
  </div>

  <div class="hx-np" data-hx-text>
    <p class="hx-mono" style="color:var(--wc)" data-np-state>{t.ready}</p>
    <h3 class="hx-h2 hx-np__title" data-np-title>{sets[0]?.title}</h3>
    <p class="hx-np__sub" data-np-sub>{sets[0]?.sub}</p>
    <div class="hx-np__wave" aria-hidden="true">{wave("klaak-sets", 110).map((h) => <i style={`--h:${h / 100}`} />)}</div>
    <a class="hx-mono hx-np__link" href={sets[0]?.url} rel="noopener" data-np-link>{t.link}</a>
  </div>
</section>

<style is:global>
  /* Lentille et portail au centre des portails (--pcy : 50 %, 38 % sur téléphone, posé par le moteur). */
  .hx-lens {
    position: absolute;
    left: 50%;
    top: var(--pcy, 50%);
    width: calc(var(--hole) * 2);
    height: calc(var(--hole) * 2);
    margin: calc(var(--hole) * -1) 0 0 calc(var(--hole) * -1);
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-void);
    isolation: isolate;
  }
  .hx-lens__in {
    position: absolute;
    inset: 0;
    transform: scale(1.1);
  }
  .hx-art {
    position: absolute;
    inset: 0;
    transition: opacity 0.6s var(--ease-klaak);
  }
  .hx-art picture {
    display: contents;
  }
  .hx-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Photo cadrée sur un point (zoom 2) : plus large que la lentille, donc sans le max-width: 100 % de base. */
  .hx-art--fit img {
    inset: auto;
    max-width: none;
    object-fit: fill;
  }
  .hx-portal,
  .hx-portal2 {
    position: absolute;
    left: 50%;
    top: var(--pcy, 50%);
    border-radius: 50%;
    box-sizing: border-box;
    pointer-events: none;
  }
  .hx-portal {
    width: calc(var(--hole) * 2 + 10px);
    height: calc(var(--hole) * 2 + 10px);
    transform: translate(-50%, -50%) rotate(var(--spin, 0deg));
    border: 3px solid var(--wc);
    border-top-color: transparent;
    box-shadow: 0 0 20px var(--wc);
  }
  .hx-portal2 {
    width: calc(var(--hole) * 2 + 34px);
    height: calc(var(--hole) * 2 + 34px);
    transform: translate(-50%, -50%) rotate(calc(var(--spin, 0deg) * -1.6));
    border: 1px dashed rgb(244 242 255 / 0.45);
  }
  .hx-pbig {
    position: absolute;
    left: 50%;
    top: var(--pcy, 50%);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 104px;
    height: 104px;
    margin: -52px 0 0 -52px;
    border: 0;
    border-radius: 50%;
    background: var(--wc);
    color: var(--color-void);
    cursor: pointer;
    box-shadow: 0 0 20px var(--wc);
  }
  .hx-pbig:focus-visible {
    outline-offset: 6px;
  }
  .hx-tl {
    position: absolute;
    left: 5vw;
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 26vw;
    min-width: 300px;
    transform: translateY(-50%);
  }
  .hx-tl__title {
    font-size: clamp(34px, 4vw, 68px);
    margin-bottom: 10px;
  }
  .hx-trk {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    min-height: 64px;
    padding: 10px 16px;
    border: 1px solid var(--color-void-3);
    background: rgb(7 6 13 / 0.7);
    color: var(--color-bone);
    text-align: left;
    cursor: pointer;
  }
  .hx-trk:hover {
    border-color: var(--color-mute);
  }
  .hx-trk.is-on {
    border-color: var(--wc);
    background: rgb(16 14 26 / 0.95);
    box-shadow: 0 0 30px rgb(0 0 0 / 0.6);
  }
  .hx-trk__n {
    font: 800 15px var(--font-display);
    color: var(--color-mute);
  }
  .hx-trk.is-on .hx-trk__n {
    color: var(--wc);
  }
  .hx-trk__txt {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hx-trk__title {
    font: 800 13px/1.2 var(--font-display);
    text-transform: uppercase;
  }
  .hx-trk__sub,
  .hx-np__sub {
    font: 400 11px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--color-mute);
  }
  .hx-np {
    position: absolute;
    right: 5vw;
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 24vw;
    min-width: 280px;
    transform: translateY(-50%);
  }
  /* Double classe : passe devant la taille générique de .hx-h2. */
  .hx-np .hx-np__title {
    font-size: clamp(20px, 2.2vw, 34px);
  }
  .hx-np__sub {
    margin: 0;
    font-size: 13px;
  }
  .hx-np__wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 72px;
    margin-top: 10px;
  }
  .hx-np__wave i {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: 1px;
    background: rgb(169 164 196 / 0.35);
  }
  .hx-np__link {
    margin-top: 8px;
    color: var(--color-acid);
  }

  /* Sans JS : sections lisibles empilées */
  html:not(.hx-on) .hx-sets {
    display: grid;
    gap: 2rem;
    padding: 4rem 6vw;
    --hole: 22vh;
  }
  html:not(.hx-on) .hx-lens,
  html:not(.hx-on) .hx-portal,
  html:not(.hx-on) .hx-portal2,
  html:not(.hx-on) .hx-pbig,
  html:not(.hx-on) .hx-np__wave {
    display: none;
  }
  html:not(.hx-on) .hx-tl,
  html:not(.hx-on) .hx-np {
    position: static;
    transform: none;
    width: auto;
  }

  /* Écran étroit : la lentille reste au centre des portails (continuité) ; titre et tracklist compacts dessous. */
  @media (max-width: 760px), (max-aspect-ratio: 9/10) {
    html.hx-on .hx-tl {
      left: 50%;
      right: auto;
      top: auto;
      bottom: 3vh;
      gap: 6px;
      width: min(92vw, 560px);
      min-width: 0;
      transform: translateX(-50%);
    }
    html.hx-on .hx-tl__title {
      font-size: clamp(26px, 8vw, 44px);
      margin-bottom: 4px;
    }
    html.hx-on .hx-trk {
      min-height: 52px;
      padding: 6px 12px;
    }
    html.hx-on .hx-np {
      display: none;
    }
    .hx-pbig {
      width: 76px;
      height: 76px;
      margin: -38px 0 0 -38px;
    }
  }
  /* Téléphone couché : tracklist et panneau resserrés de part et d'autre de la lentille. */
  @media (max-height: 520px) and (min-aspect-ratio: 9/10) {
    html.hx-on .hx-tl {
      top: calc(50% + 24px);
      gap: 6px;
    }
    html.hx-on .hx-tl__title {
      font-size: 26px;
      margin-bottom: 0;
    }
    html.hx-on .hx-trk {
      min-height: 44px;
      padding: 4px 12px;
    }
    html.hx-on .hx-np {
      top: calc(50% + 24px);
      gap: 8px;
    }
    .hx-np__wave {
      height: 40px;
    }
    .hx-pbig {
      width: 64px;
      height: 64px;
      margin: -32px 0 0 -32px;
    }
  }
</style>
