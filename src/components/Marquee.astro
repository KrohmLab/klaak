---
interface Props {
  items: string[];
  class?: string;
  seconds?: number;
}
const { items, class: cls = "", seconds = 18 } = Astro.props;
---

<div class:list={["marquee", cls]} style={`--marquee-dur:${seconds}s`}>
  {
    [false, true].map((clone) => (
      <div class="marquee__track" aria-hidden={clone ? "true" : undefined}>
        {items.map((item, i) => (
          <span class={i % 2 ? "outline-text" : ""}>{item}</span>
        ))}
      </div>
    ))
  }
</div>
